@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# No components means the historical aggregate targets. Explicit core/io users
# never have to find or install Ivy, even if this SDK was built with Ivy enabled.
if(NOT pprzlink++_FIND_COMPONENTS)
    set(pprzlink++_FIND_COMPONENTS legacy)
endif()
foreach(component IN LISTS pprzlink++_FIND_COMPONENTS)
    if(NOT component MATCHES "^(core|io|ivy|legacy)$")
        set(pprzlink++_FOUND FALSE)
        set(pprzlink++_NOT_FOUND_MESSAGE "Unknown pprzlink component: ${component}")
        return()
    endif()
    if(component STREQUAL "ivy" AND NOT @PPRZLINK_WITH_IVY@)
        set(pprzlink++_FOUND FALSE)
        set(pprzlink++_NOT_FOUND_MESSAGE "This pprzlink installation was built without Ivy")
        return()
    endif()
endforeach()

find_dependency(tinyxml2)
find_dependency(Boost 1.83 CONFIG)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/pprzlink_coreTargets.cmake")
set(pprzlink++_core_FOUND TRUE)

if("io" IN_LIST pprzlink++_FIND_COMPONENTS OR "legacy" IN_LIST pprzlink++_FIND_COMPONENTS)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/pprzlink_ioTargets.cmake")
    set(pprzlink++_io_FOUND TRUE)
endif()
if("ivy" IN_LIST pprzlink++_FIND_COMPONENTS OR ("legacy" IN_LIST pprzlink++_FIND_COMPONENTS AND @PPRZLINK_WITH_IVY@))
    find_dependency(Threads)
    find_dependency(PkgConfig)
    pkg_check_modules(IVY REQUIRED IMPORTED_TARGET ivy-cpp>=3.18)
    include("${CMAKE_CURRENT_LIST_DIR}/pprzlink_ivyTargets.cmake")
    set(pprzlink++_ivy_FOUND TRUE)
endif()
if("legacy" IN_LIST pprzlink++_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/pprzlink++Targets.cmake")
    set(pprzlink++_legacy_FOUND TRUE)
endif()
check_required_components(pprzlink++)
